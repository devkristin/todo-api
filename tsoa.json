{
  "compilerOptions": {
    "strict": true
  },
  "controllerPathGlobs": ["src/features/**/*.controller.ts"],
  "entrypoint": "src/app.ts",
  "noImplicitAdditionalProperties": "silently-remove-extras",
  "routes": {
    "authenticationModule": "src/auth.ts",
    "iocModule": "",
    "middleware": "express",
    "routesDir": "src/generated"
  },
  "spec": {
    "outputDirectory": "src/generated",
    "securityDefinitions": {
      "jwt": {
        "description": "Enter your planner credentials to log in natively via Swagger UI.",
        "flows": {
          "password": {
            "scopes": {},
            "tokenUrl": "/auth/login"
          }
        },
        "type": "oauth2"
      }
    },
    "spec": {
      "servers": [
        {
          "url": "http://localhost:3000"
        }
      ]
    },
    "specMerging": "recursive",
    "specVersion": 3
  }
}
